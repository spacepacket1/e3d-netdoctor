{
  "name": "e3d-netdoctor",
  "version": "1.0.0",
  "type": "module",
  "description": "Standalone CLI scaffold for local network slowdown diagnosis.",
  "bin": {
    "e3d-netdoctor": "bin/e3d-netdoctor.js"
  },
  "files": [
    "bin",
    "src",
    "fixtures",
    "docs/payment-gate.md"
  ],
  "scripts": {
